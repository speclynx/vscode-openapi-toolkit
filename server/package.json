{
  "name": "@speclynx/api-language-server",
  "description": "API language server (LSP) providing validation, linting, completion, hover and navigation for OpenAPI/Swagger 2.0, OpenAPI 3.0 and 3.1 documents in JSON and YAML.",
  "version": "1.6.0",
  "publisher": "SpecLynx",
  "author": "SpecLynx",
  "license": "Apache-2.0",
  "contributors": [
    {
      "name": "Francesco Tumanischvili",
      "email": "frantuma@yahoo.com"
    },
    {
      "name": "Vladimir Gorej",
      "email": "vladimir.gorej@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/speclynx/vscode-openapi-toolkit",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/speclynx/vscode-openapi-toolkit/issues"
  },
  "homepage": "https://github.com/speclynx/vscode-openapi-toolkit/tree/main/server#readme",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@speclynx/api-languageservice": "^2.13.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "peerDependenciesMeta": {
    "@speclynx/api-languageservice": {
      "optional": true
    },
    "vscode-languageserver": {
      "optional": true
    },
    "vscode-languageserver-protocol": {
      "optional": true
    },
    "vscode-languageserver-textdocument": {
      "optional": true
    }
  },
  "main": "./dist/node/server.js",
  "types": "./dist/types/node/bin.d.ts",
  "bin": {
    "speclynx-lsp": "./dist/node/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/node/bin.d.ts",
      "default": "./dist/node/server.js"
    },
    "./node": {
      "types": "./dist/types/node/bin.d.ts",
      "default": "./dist/node/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/node/server.js",
    "dist/node/cli.js",
    "dist/node/THIRD-PARTY-NOTICES.txt",
    "dist/node/THIRD-PARTY-INVENTORY.json",
    "dist/types/**/*.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "keywords": [
    "openapi",
    "lsp",
    "language-server",
    "swagger",
    "apidom",
    "validation",
    "linting"
  ],
  "scripts": {
    "clean": "npm run clean:dev && npm run clean:prod",
    "clean:dev": "rimraf out tsconfig.tsbuildinfo",
    "clean:prod": "rimraf dist",
    "clean:standalone": "rimraf dist/node/server.js dist/node/cli.js dist/node/THIRD-PARTY-NOTICES.txt dist/node/THIRD-PARTY-INVENTORY.json dist/types",
    "build:prod": "npm run clean:prod && npm run build:prod:node && npm run build:prod:browser && npm run build:standalone",
    "build:prod:node": "webpack --config config/webpack.node.cjs --progress",
    "build:prod:browser": "webpack --config config/webpack.browser.cjs --progress",
    "build:lib": "tsc -b",
    "build:standalone": "npm run clean:standalone && npm run build:types && webpack --config config/webpack.standalone.cjs",
    "prepack": "npm run build:standalone",
    "test": "npm run test:unit && npm run test:standalone && node ../scripts/test-artifacts.mjs",
    "test:unit": "mocha --timeout 30000 out/test",
    "test:standalone": "mocha --timeout 60000 out/test/standalone",
    "test:package": "node ../scripts/test-artifacts.mjs",
    "test:plugin": "node ../scripts/test-artifacts.mjs",
    "typescript:check-types": "tsc --noEmit",
    "typescript:check-types:watch": "npm run typescript:check-types -- --watch",
    "lint": "eslint ./",
    "lint:fix": "eslint ./ --fix",
    "build:types": "tsc -p config/tsconfig.types.json"
  },
  "devDependencies": {
    "@speclynx/apidom-core": "^5.1.0",
    "@speclynx/api-languageservice": "^2.13.1",
    "@speclynx/apidom-reference": "^5.2.6",
    "@stoplight/spectral-core": "^1.23.1",
    "@stoplight/spectral-functions": "^1.10.5",
    "@stoplight/spectral-ruleset-bundler": "^1.7.0",
    "@stoplight/spectral-rulesets": "^1.22.7",
    "@types/mocha": "^10.0.10",
    "buffer": "^5.7.1",
    "redos-detector": "^6.1.4",
    "supports-color": "^7.2.0",
    "urljs": "^2.7.0",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "^3.17.5",
    "vscode-uri": "^3.1.0",
    "yaml": "^2.9.0"
  }
}
